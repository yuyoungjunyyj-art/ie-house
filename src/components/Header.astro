---
import Mark from './Mark.astro';
import { content, href } from '../lib/i18n';

const { locale, area } = Astro.props;
const { site } = content(locale);
const here = Astro.url.pathname.replace(/\/?$/, '/');
const teaHome = href(locale, '/tea');
const currentFor = (target: string) => {
  if (here === target) return 'page';
  return target === teaHome && area === 'tea' ? 'true' : undefined;
};
---
<a class="skip" href="#main">{site.nav.skip}</a>
<header class="header">
  <a class="wordmark" href={href(locale, '/')} aria-label={site.wordmark.brand}>
    <Mark />
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {site.nav.brand.map((link: { label: string; href: string }) => {
        const target = href(locale, link.href);
        return (
          <li><a href={target} aria-current={currentFor(target)}>{link.label}</a></li>
        );
      })}
    </ul>
  </nav>
  {area === 'tea' && (
    <nav class="subnav" aria-label={site.wordmark.tea}>
      <ul>
        {site.nav.tea.map((link: { label: string; href: string }) => {
          const target = href(locale, link.href);
          return (
            <li><a href={target} aria-current={here === target ? 'page' : undefined}>{link.label}</a></li>
          );
        })}
      </ul>
    </nav>
  )}
</header>
